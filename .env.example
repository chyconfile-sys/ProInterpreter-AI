APP_ENV=development
APP_ALLOWED_ORIGINS=http://localhost:8000
AUDIO_UPLOAD_SECRET=replace-with-random-secret

# Example speech provider
SPEECH_PROVIDER=azure-speech
AZURE_SPEECH_KEY=replace-with-key
AZURE_SPEECH_REGION=eastus

# Example translation provider
TRANSLATION_PROVIDER=azure-openai
AZURE_OPENAI_ENDPOINT=https://example-resource.openai.azure.com
AZURE_OPENAI_KEY=replace-with-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Optional
API_RATE_LIMIT=60
